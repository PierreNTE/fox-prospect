# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Protection de l'app (Basic Auth) ---
# Sans APP_PASSWORD, l'app est ouverte a tous : a definir absolument sur Vercel
APP_USER=pierre
APP_PASSWORD=choisis-un-mot-de-passe-solide

# --- Garde-fous production (optionnels) ---
# Nombre max de recherches web par qualification (defaut : 2).
# Mesure du 2026-07-27 sur 160 prospects qualifies, tarifs corriges :
# ~0,093 EUR/qualif -> ~160 prospects/mois dans un budget de 15 EUR.
# (La valeur de ~0,045 EUR affichee ici auparavant etait fausse d'un facteur 2.)
# Le poste dominant n'est pas le NOMBRE de recherches mais le VOLUME de jetons
# qu'elles ramenent : baisser ce reglage sous 2 ne rendrait presque rien.
RESEARCH_MAX_SEARCHES=2
# Plafond d'appels LLM par 24 h, securite budget en VOLUME (defaut : 50).
# Compte les qualifications ET les analyses de comptes, via l'unique compteur
# dailyLlmCount() de lib/budget.js — partage par la qualif manuelle et le drain
# autonome. Jusqu'au 2026-08-13 le drain comptait les comptes rafraichis, que
# les jobs research_prospect ne touchent jamais : son plafond ne mordait donc
# jamais et le kill-switch en euros etait le seul frein.
DAILY_RESEARCH_CAP=50
# Kill-switch budget MENSUEL en EUR (defaut : 15). Des que le cout Anthropic
# cumule du mois (table ai_runs) atteint ce seuil, toute qualif/analyse est
# coupee (manuelle ET autonome) et reprend le 1er du mois suivant.
#
# Ce plafond a valu 13 EUR le temps de compenser un tarif Haiku perime dans
# ANTHROPIC_TARIF (celui de Haiku 3.5, pour un modele haiku-4-5 facture quatre
# fois plus). Le tarif corrige a la source le 2026-07-27, ai_runs colle a la
# facture : garder 13 EUR deduirait deux fois la meme erreur. A 15 EUR la
# coupure tombe vers 16 USD, sous un plafond de compte a 20 USD.
# Si le plafond de la console bouge, celui-ci doit bouger avec.
MONTHLY_BUDGET_EUR=15
# Lissage sur le mois (actif par defaut). Au jour D d'un mois de N jours, la
# depense cumulee ne peut exceder budget x D/N, plus 15 % de reserve pour que le
# 1er du mois reste utilisable. Sans lui, rien n'empeche de bruler le mois en
# quatre jours -- ce qui s'est produit en juillet 2026. BUDGET_PACING=off
# desarme le lissage sans toucher au plafond mensuel.
BUDGET_PACING=on
# Qualification AUTONOME (defaut : on). Le cron auto-promeut les contacts scrapes
# en prospects puis enfile leur qualification (bornee par le budget mensuel).
# Mettre AUTO_QUALIFY=off pour revenir au mode 100% manuel (clic "Qualifier").
AUTO_QUALIFY=on
# Nb max de jobs (analyse/qualif) traites par passage du drain (defaut : 8).
# Borne le temps d execution (chaque job ~15-30 s, maxDuration 300 s).
JOBS_PER_RUN=8

# --- Worker de scraping (GitHub Actions) ---
# Cote VERCEL : permet a l'app de declencher le worker en quasi-instantane via
# repository_dispatch. Sans ces variables, l'app met juste le job en file et le
# cron GitHub (toutes les 6 h) le traitera (degradation gracieuse).
#   GITHUB_DISPATCH_TOKEN : PAT fine-grained, repo fox-prospect, permission
#                           "Contents: Read and write" (requise par l'API dispatches).
#   GITHUB_REPO           : owner/repo, ex. PierreNTE/fox-prospect
GITHUB_DISPATCH_TOKEN=github_pat_...
GITHUB_REPO=PierreNTE/fox-prospect
#
# Cote GITHUB (repo > Settings > Secrets and variables > Actions) : le worker a
# besoin de SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY en secrets (pas ici).
#   SCRAPE_PROXY : secret GitHub = proxy residentiel (http://user:pass@host:port).
#                  INDISPENSABLE depuis une IP datacenter (GitHub Actions) : sans
#                  lui, DuckDuckGo/LinkedIn bloquent le runner. Inutile en local.
# Plafonds optionnels en "Variables" repo : SCRAPE_JOB_BATCH (def. 5),
# SCRAPE_PROFILE_LIMIT (def. 8).
