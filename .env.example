# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Protection de l'app (Basic Auth) ---
# Sans APP_PASSWORD, l'app est ouverte a tous : a definir absolument sur Vercel
APP_USER=pierre
APP_PASSWORD=choisis-un-mot-de-passe-solide

# --- Garde-fous production (optionnels) ---
# Nombre max de recherches web par qualification (defaut : 4).
# Si des recherches tombent en 504 sur Vercel Hobby, baisser a 3.
RESEARCH_MAX_SEARCHES=4
# Plafond de recherches par 24 h, securite budget (defaut : 50).
DAILY_RESEARCH_CAP=50
