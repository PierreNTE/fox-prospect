# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Protection de l'app (Basic Auth) ---
# Sans APP_PASSWORD, l'app est ouverte a tous : a definir absolument sur Vercel
APP_USER=pierre
APP_PASSWORD=choisis-un-mot-de-passe-solide

# --- Garde-fous production (optionnels) ---
# Nombre max de recherches web par qualification (defaut : 4).
# Si des recherches tombent en 504 sur Vercel Hobby, baisser a 3.
RESEARCH_MAX_SEARCHES=4
# Plafond de recherches par 24 h, securite budget (defaut : 50).
DAILY_RESEARCH_CAP=50

# --- Worker de scraping (GitHub Actions) ---
# Cote VERCEL : permet a l'app de declencher le worker en quasi-instantane via
# repository_dispatch. Sans ces variables, l'app met juste le job en file et le
# cron GitHub (toutes les 6 h) le traitera (degradation gracieuse).
#   GITHUB_DISPATCH_TOKEN : PAT fine-grained, repo fox-prospect, permission
#                           "Contents: Read and write" (requise par l'API dispatches).
#   GITHUB_REPO           : owner/repo, ex. PierreNTE/fox-prospect
GITHUB_DISPATCH_TOKEN=github_pat_...
GITHUB_REPO=PierreNTE/fox-prospect
#
# Cote GITHUB (repo > Settings > Secrets and variables > Actions) : le worker a
# besoin de SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY en secrets (pas ici).
#   SCRAPE_PROXY : secret GitHub = proxy residentiel (http://user:pass@host:port).
#                  INDISPENSABLE depuis une IP datacenter (GitHub Actions) : sans
#                  lui, DuckDuckGo/LinkedIn bloquent le runner. Inutile en local.
# Plafonds optionnels en "Variables" repo : SCRAPE_JOB_BATCH (def. 5),
# SCRAPE_PROFILE_LIMIT (def. 8).
